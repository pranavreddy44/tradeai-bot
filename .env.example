# ── Core ──────────────────────────────────────────────────────────────────────
# SQLite database file (relative to the app root in dev; docker-compose overrides
# this to file:/app/db/dev.db so it persists in the app-db volume).
DATABASE_URL="file:./dev.db"

# ── OmniRoute (default AI provider) ───────────────────────────────────────────
# LOCAL DEV (npm run dev): OmniRoute runs on your machine → use localhost.
# OMNIROUTE_BASE_URL="http://localhost:20128/v1/chat/completions"
#
# DOCKER (docker compose): the app container reaches OmniRoute by compose DNS,
# so the compose file overrides this automatically — leave it unset here.
# OMNIROUTE_KEY=""
# OMNIROUTE_MODEL="auto"
# OMNIROUTE_JSON_MODEL="oc/nemotron-3-ultra-free"
# OMNIROUTE_VISION_MODEL="oc/mimo-v2.5-free"

# ── Groq (fallback / second provider) ─────────────────────────────────────────
# GROQ_API_KEY=""
# GROQ_MODEL=""

# ── OmniRoute container (used by docker-compose.yml) ──────────────────────────
# Generates secrets: openssl rand -hex 32
# OMNIROUTE_PUBLIC_URL="https://llms.yourdomain.com"
# OMNIROUTE_WS_BRIDGE_SECRET="REPLACE-with-openssl-rand-hex-32"
# OMNIROUTE_INITIAL_PASSWORD="CHANGE_ME"            # dashboard login password
# OMNIROUTE_JWT_SECRET="REPLACE-with-openssl-rand-hex-32"
# OMNIROUTE_API_KEY_SECRET="REPLACE-with-openssl-rand-hex-32"
# OMNIROUTE_STORAGE_ENCRYPTION_KEY="REPLACE-with-openssl-rand-hex-32"
# OMNIROUTE_MACHINE_ID_SALT="REPLACE-with-openssl-rand-hex-32"
# OMNIROUTE_AUTH_COOKIE_SECURE="false"              # set true behind HTTPS
# OMNIROUTE_REQUIRE_API_KEY="false"

# ── App security ───────────────────────────────────────────────────────────────
# If set, /api/seed (which DELETES all data) also requires ?token=<this value>.
# SEED_CONFIRM_TOKEN=""
